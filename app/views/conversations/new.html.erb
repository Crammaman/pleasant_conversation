<% content_for :title, "New Conversation" %>

<h1 class="title"><%= @queue.profile.display_name %> — New Conversation</h1>

<%= form_with model: [ @queue, @conversation ], url: queue_conversations_path(@queue), method: :post do |f| %>
  <div class="field">
    <%= f.label :name, "Conversation name", class: "label" %>
    <div class="control">
      <%= f.text_field :name, class: "input", autofocus: true,
                       placeholder: "e.g. Morning catch-up" %>
    </div>
  </div>

  <%= f.fields_for :answers do |answer_fields| %>
    <% question = answer_fields.object.question %>
    <div class="field">
      <%= answer_fields.hidden_field :question_id, value: question.id %>
      <%= answer_fields.hidden_field :question_text, value: question.text %>
      <label class="label"><%= question.text %></label>

      <% case question.question_type %>
      <% when "select" %>
        <div class="control">
          <div class="select is-fullwidth">
            <%= answer_fields.select :value,
                  options_for_select(question.options),
                  { include_blank: "Choose…" } %>
          </div>
        </div>
      <% when "radio" %>
        <div class="control">
          <% question.options.each do |option| %>
            <label class="radio">
              <%= answer_fields.radio_button :value, option %>
              <%= option %>
            </label>
          <% end %>
        </div>
      <% else %>
        <div class="control">
          <%= answer_fields.text_field :value, class: "input" %>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="field is-grouped mt-5">
    <div class="control">
      <%= f.submit "Add Conversation", class: "button is-primary" %>
    </div>
    <div class="control">
      <%= link_to "Cancel", queue_path(@queue), class: "button is-light" %>
    </div>
  </div>
<% end %>
