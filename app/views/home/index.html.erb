<% content_for :title, "Profiles" %>

<h1 class="title">Profiles</h1>

<% if @profiles.any? %>
  <div class="columns is-multiline">
    <% @profiles.each do |profile| %>
      <% count = @conversation_counts[profile.id] || 0 %>
      <div class="column is-one-third">
        <div class="card">
          <header class="card-header">
            <p class="card-header-title"><%= profile.display_name %></p>
          </header>
          <div class="card-content">
            <p><%= pluralize(count, "conversation") %></p>
          </div>
          <footer class="card-footer">
            <%= link_to "Current Queue", queue_profile_path(profile), class: "card-footer-item" %>
          </footer>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="notification is-info is-light">
    <p>No profiles yet.</p>
    <%= link_to "Add a user", new_user_path, class: "button is-primary mt-3" %>
  </div>
<% end %>
